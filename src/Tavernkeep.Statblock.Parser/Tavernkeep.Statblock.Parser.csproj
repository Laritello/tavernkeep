<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Demo.txt" />
    <None Remove="Resources\pathbuilder.json" />
    <None Remove="Resources\pf-action-1.png" />
    <None Remove="Resources\pf-action-2.png" />
    <None Remove="Resources\pf-action-3.png" />
    <None Remove="Resources\pf-action-free.png" />
    <None Remove="Resources\pf-action-reaction.png" />
    <None Remove="Resources\Template.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\pathbuilder.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\pf-action-1.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\pf-action-2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\pf-action-3.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\pf-action-free.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\pf-action-reaction.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Resources\Template.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tavernkeep.Core\Tavernkeep.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Demo.txt" />
  </ItemGroup>

</Project>
